# Example environment variables for the backend
# Copy to .env.local (api/.env.local) and fill values before running or deploying

DATABASE_URL=postgresql://user:password@db-host:5432/dbname
SUPABASE_URL=
SUPABASE_URL_PRODUCTION=
SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=products
CORS_ORIGINS=https://www.urbansportstore.online,http://localhost:4173

# Wompi Colombia sandbox. Keep the private and events secrets server-side only.
WOMPI_ENVIRONMENT=sandbox
WOMPI_API_BASE_URL=https://sandbox.wompi.co/v1
WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_SANDBOX_EVENTS_SECRET=
WOMPI_EVENTS_SECRET=

# Only required when WOMPI_ENVIRONMENT=production and VERCEL_ENV=production.
# Confirm the live API hostname with Wompi before setting this value.
WOMPI_API_BASE_URL_PRODUCTION=
WOMPI_PUBLIC_KEY_PRODUCTION=
WOMPI_PRIVATE_KEY_PRODUCTION=
# Must be the Wompi Production event secret, not the private API key.
WOMPI_EVENTS_KEY_PRODUCTION=

# Configure a unique E2E_SECRET only in a dedicated test environment.
NODE_ENV=production
PORT=4000
NODE_ENV=development

# Database connection URL for local development
# Set this to your local PostgreSQL instance if needed
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/urbansportstore

# JWT Configuration
JWT_SECRET=replace-me-with-strong-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_TTL_DAYS=7

# Cookie & Security
COOKIE_SAMESITE=lax
SECURE_COOKIES=false

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Supabase Integration (admin backend access)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<get-from-supabase-dashboard>

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10

# E2E Testing
E2E_SECRET=
