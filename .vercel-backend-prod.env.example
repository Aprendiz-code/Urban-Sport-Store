# Example for Vercel backend deployment configuration.
# Copy this file to .vercel-backend-prod.env and replace values before deployment.
# Never commit real tokens, service-role keys, or secrets.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=
VERCEL_OIDC_TOKEN=
