{
  "rewrites": [
    { "source": "/((?!api).*)", "destination": "/index.html" }
  ],
  "routes": [
    {
      "src": "^/api/admin/?$",
      "dest": "/api/products",
      "transforms": [{ "type": "request.path", "op": "set", "args": "/api/admin/_root" }]
    },
    {
      "src": "^/api/admin/(.*)$",
      "dest": "/api/products",
      "transforms": [{ "type": "request.path", "op": "set", "args": "/api/admin/$1" }]
    }
  ]
}
