# Exclude legacy API build artifacts and server snapshots from Vercel deployments
# These folders contain legacy Express app artifacts and compiled bundles that
# would conflict with the intended Vercel serverless functions in `api/*.ts`.

# Exclude local env and temporary validation artifacts from deployment
.env*.local
.vercel-backend-*.env
.tmp-*.mjs
supabase_token_response.json
test-results/**

# Exclude legacy compiled API artifacts
api/dist/**

# Exclude legacy Express app source (not used by serverless runtime)
api/src/**

# Exclude local env and Vercel local state
api/.vercel/**

# Exclude non-endpoint config/metadata files under api/ so Vercel does not
# count them as serverless functions (Hobby plan limit: 12 per deployment).
# NOTE: api/lib/** is NOT excluded here — those modules are imported by
# endpoints at runtime and must be uploaded. Instead, vercel.json "functions"
# explicitly lists only the 11 endpoint files, preventing Vercel from
# detecting lib files as standalone serverless functions.
api/vitest.config.ts
api/eslint.config.mjs

api/README.md

# Exclude example/legacy endpoint not used in production
api/hello.js

# Archive folder should not be deployed
archive/**

