# Keep only the consolidated API entrypoint in the Vercel deployment.
# This reduces the serverless function count to one so the project can deploy on
# the free Hobby tier without hitting Vercel's 12-function cap.

# Exclude all legacy route modules that are intentionally consolidated into
# api/index.ts for the public deployment.
api/account/**
api/admin/**
api/test/**
api/categories.ts
api/health.ts
api/home.ts
api/newsletter.ts
api/orders.ts
api/products.ts

# Exclude legacy build outputs and local metadata.
api/dist/**
api/src/**
api/.vercel/**
api/vitest.config.ts
api/eslint.config.mjs
api/README.md
api/hello.js
archive/**
.vercel-production.env

