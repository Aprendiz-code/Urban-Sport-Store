api/dist/**
api/src/**
api/.vercel/**
api/vitest.config.ts
api/eslint.config.mjs
api/README.md
api/hello.js
archive/**
.vercel-production.env


secrets
secrets/
*.env
.env
.env.*
.vercel-backend-prod.env
.vercel-backend-prod-pulled.env
.vercel-backend-prod.env.example
.vercel-backend-prod-pulled.env.example
