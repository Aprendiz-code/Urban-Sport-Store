# Example environment variables for the project root.
# Copy to .env.local for local development and keep real secrets out of version control.
# Never commit real credentials or tokens.

# Frontend-safe variables only
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_STORAGE_BUCKET=products
VITE_API_URL=http://127.0.0.1:3000/api
VITE_TERMS_URL=
VITE_PRIVACY_POLICY_URL=

# Runtime
NODE_ENV=development

# In production, prefer a public API URL or a secure reverse proxy target.
# The service role key must remain on the server side only.
