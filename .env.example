# Example environment variables for the frontend
# Copy to .env.local and fill values before running or deploying

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_STORAGE_BUCKET=products
VITE_API_URL=http://localhost:3000/api

# The backend runtime uses api/.env.local and requires SUPABASE_URL, SUPABASE_ANON_KEY, and SUPABASE_SERVICE_ROLE_KEY.

# Do NOT store the service role key in client-side files or commit it.
